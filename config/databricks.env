# Databricks connection — NO secrets here.
# Credentials live in the OS credential store (auth_storage=secure) / ~/.databrickscfg.
# refresh.py reads this only to pick the profile for the live-vs-snapshot probe.

DATABRICKS_PROFILE=DEFAULT

# The probe target. refresh runs, with a short timeout:
#   databricks --profile "$DATABRICKS_PROFILE" current-user
# Exit 0 -> live mode. Non-zero -> snapshot mode (use the committed snapshot).
#
# Home machine: this fails ("stored credentials from older CLI versions are no
# used") -> the system degrades to code-only graph + committed snapshot.
# Work laptop: this succeeds -> live grounding.
